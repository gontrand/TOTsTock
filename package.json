{
  "name": "react-example",
  "private": true,
  "version": "5.16.2",
  "type": "module",
  "scripts": {
    "predev": "npm run build:sql",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "check:version": "node scripts/check-version.mjs",
    "build:sql": "node scripts/build-sql.mjs",
    "bundle:functions": "node scripts/bundle-functions.mjs",
    "install:tot": "node scripts/tot-install.mjs",
    "build": "npm run check:version && npm run build:sql && vite build",
    "pretest": "npm run build:sql",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "deploy:client:functions": "npx supabase functions deploy",
    "deploy:master:functions": "supabase functions deploy --workdir supabase-master",
    "cap:sync": "npx cap sync android",
    "build:android": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "desktop:dev": "npm run build && npm --prefix desktop run dev",
    "desktop:build": "npm run build && npm --prefix desktop run dist",
    "desktop:pack": "npm run build && npm --prefix desktop run pack"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/library": "^0.23.0",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "idb": "^8.0.3",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0 || ^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
